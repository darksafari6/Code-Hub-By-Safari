# ---------------------------------------------------------------------------
# Safari AI Dev Studio — environment
# Copy this file to `.env` and fill in what you use. Everything is optional:
# the IDE runs without any AI provider, the assistant simply reports that it
# is not configured.
# ---------------------------------------------------------------------------

# Server
PORT=3000
HOST=0.0.0.0
# Optional. When set, every /api request and terminal connection must present
# this token (`x-safari-token` header, `?token=` query or Bearer auth).
# Required if you expose the IDE beyond localhost.
# SAFARI_ACCESS_TOKEN=
# Optional workspace override (defaults to ./workspace)
# WORKSPACE_DIR=

# AI providers (configure at least one)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# Any OpenAI-compatible endpoint (OpenAI, OpenRouter, Groq, Ollama, vLLM...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

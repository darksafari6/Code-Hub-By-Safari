{
  "name": "safari-ai-dev-studio",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "An open-source, AI-assisted development environment for Linux desktops.",
  "license": "MIT",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "npm run clean && npm run build:web && npm run build:server",
    "build:web": "node scripts/build-web.mjs",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-server/index.js --packages=external",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist dist-server release",
    "desktop": "electron electron/main.cjs",
    "dist:desktop": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@google/genai": "^1.46.0",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "isomorphic-git": "^1.37.4",
    "lucide-react": "^0.546.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "ws": "^8.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.4",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.1",
    "vitest": "^5.1.1"
  },
  "build": {
    "appId": "com.safariaidevstudio.app",
    "productName": "Safari AI Dev Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
